{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/NexDown/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/NexDown/assets/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/NexDown/:path*"
    }
  ]
}
