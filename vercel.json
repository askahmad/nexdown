{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/assets/NexDown-Setup.exe",
      "destination": "https://github.com/askahmad/nexdown/releases/download/v1.0.1/NexDown-Setup.exe",
      "permanent": false
    },
    {
      "source": "/NexDown/assets/NexDown-Setup.exe",
      "destination": "https://github.com/askahmad/nexdown/releases/download/v1.0.1/NexDown-Setup.exe",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/NexDown/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/NexDown/assets/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/NexDown/:path*"
    }
  ]
}
