{
  "name": "NexDown-backend",
  "version": "1.0.0",
  "description": "Local backend server for NexDown Chrome Extension",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.nexdown.desktop",
    "productName": "NexDown",
    "publish": [
      {
        "provider": "github",
        "owner": "Ahmedkhn143",
        "repo": "Video-Downlode-Extension"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../extension/icon128.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "author": "Ahmad Khan",
  "repository": "https://github.com/Ahmedkhn143/Video-Downlode-Extension",
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.0.1"
  }
}
